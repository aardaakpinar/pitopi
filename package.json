{
  "name": "pitopi",
  "version": "1.1.0",
  "description": "Secure Socket.IO chat application with end-to-end encrypted messaging and Firebase storage",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i app/assets/style/tailwind.input.css -o app/assets/style/tailwind.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.cjs -i app/assets/style/tailwind.input.css -o app/assets/style/tailwind.css --watch",
    "dev": "npm run build:css && tsx watch src/server.ts",
    "build": "npm run build:css && tsc -p tsconfig.json && node ./scripts/copy-app.js",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit": "npm audit --omit=dev"
  },
  "keywords": [
    "chat",
    "e2ee",
    "socket.io",
    "firebase",
    "secure-messaging"
  ],
  "author": "aardaakpinar",
  "license": "GPL-3.0-only",
  "dependencies": {
    "express": "^5.2.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aardaakpinar/pitopi.git"
  },
  "bugs": {
    "url": "https://github.com/aardaakpinar/pitopi/issues"
  }
}

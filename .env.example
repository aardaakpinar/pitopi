# Copy to .env (never commit it) or set these in your hosting provider.
NODE_ENV=production
PORT=3000

# REQUIRED in production, >= 32 random characters. Used to derive pseudonymous
# ids and to anonymise IPs in audit logs. Generate: openssl rand -hex 32
SERVER_SECRET=

# Number of reverse proxies in front of the app (Render/Heroku/Cloud Run = 1,
# direct exposure = 0). Controls how X-Forwarded-For is trusted.
TRUST_PROXY_HOPS=1

# Optional: extra browser origins allowed besides same-origin (comma separated).
ALLOWED_ORIGINS=

# Firebase: prefer the inline JSON secret in production over a file on disk.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-key.json
FIREBASE_DATABASE_URL=https://pitopi-server-default-rtdb.europe-west1.firebasedatabase.app/
